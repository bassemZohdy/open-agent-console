# Copy this file to .env before starting Docker Compose.
# Keep secrets out of Git and replace these comments with protected values.

# Provider credentials (uncomment only what the configured models use).
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Startup provider discovery. Configured keys are queried for available models;
# a provider that cannot be reached is skipped without blocking other providers.
# OAC_PROVIDER_DISCOVERY_TIMEOUT_MS=10000
# OAC_PROVIDER_DISCOVERY_MAX_MODELS=500
# Optional OpenAI-compatible provider in addition to OpenRouter.
# OAC_OPENAI_COMPATIBLE_API_KEY=
# OAC_OPENAI_COMPATIBLE_BASE_URL=https://example.com/v1

# Demo credentials. Replace these values before exposing the console.
OAC_ADMIN_USERNAME=admin
OAC_ADMIN_PASSWORD=admin
OAC_USER_USERNAME=demo
OAC_USER_PASSWORD=demo
# Optional guest account. Leave unset when guest access is not needed.
# OAC_GUEST_USERNAME=guest
# OAC_GUEST_PASSWORD=guest
OAC_SESSION_TTL_MS=28800000
OAC_AUTH_COOKIE_SECURE=false
# Trusted external origin used in published A2A Agent Cards. Leave unset for local host-derived URLs.
# OAC_A2A_PUBLIC_BASE_URL=https://agents.example.com

# Legacy single-role fallback used only when no credential accounts are configured.
OAC_ROLE=admin

# Optional runtime bounds. Safe defaults are used when omitted.
OAC_MAX_HISTORY_MESSAGES=80
OAC_MAX_HISTORY_CHARS=120000
OAC_MAX_CONTEXT_CHARS=100000
OAC_MAX_MEMORY_ENTRIES=100
OAC_MCP_TIMEOUT_MS=15000
OAC_MAX_MCP_RESPONSE_BYTES=1000000
