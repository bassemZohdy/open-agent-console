{
  "openapi": "3.1.0",
  "info": {
    "title": "Open Agent Console API",
    "version": "0.4.0",
    "description": "Checked REST and server-sent event contract for the Open Agent Console control plane."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Readiness check",
        "responses": {
          "200": {
            "description": "Database is ready"
          },
          "503": {
            "description": "Database is unavailable"
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "summary": "List models",
        "responses": {
          "200": {
            "description": "Models"
          }
        }
      },
      "post": {
        "summary": "Create a model",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created model"
          }
        }
      }
    },
    "/api/agents": {
      "get": {
        "summary": "List agents",
        "responses": {
          "200": {
            "description": "Agents"
          }
        }
      },
      "post": {
        "summary": "Create an agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created agent"
          }
        }
      }
    },
    "/api/agents/{agentId}/chat": {
      "post": {
        "summary": "Stream an agent response",
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-sent events stream"
          }
        }
      }
    },
    "/api/agents/{agentId}/mappings": {
      "put": {
        "summary": "Replace agent skill and tool mappings",
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentMappings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated mappings"
          }
        }
      }
    },
    "/api/registry/export": {
      "get": {
        "summary": "Export registry configuration",
        "responses": {
          "200": {
            "description": "Registry export",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistryImport"
                }
              }
            }
          }
        }
      }
    },
    "/api/registry/import": {
      "post": {
        "summary": "Import registry configuration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistryImport"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import result"
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "summary": "List sessions",
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions"
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "summary": "List runs",
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "running",
                "completed",
                "failed",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Runs"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateModel": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "openai-compatible",
              "anthropic",
              "google",
              "ollama",
              "fake"
            ]
          },
          "modelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "baseUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "apiKeyEnv": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^$|^[A-Z][A-Z0-9_]*$"
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "maxTokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "capabilities": {
            "default": [
              "streaming"
            ],
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "streaming",
                "tools",
                "vision",
                "audio",
                "structured-output"
              ]
            }
          },
          "timeoutMs": {
            "default": 60000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 300000
          },
          "maxRetries": {
            "default": 2,
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "name",
          "provider",
          "modelId",
          "apiKeyEnv",
          "capabilities",
          "timeoutMs",
          "maxRetries"
        ],
        "additionalProperties": false
      },
